# Optional overrides. Existing Codex login/config is reused. No API key in frontend.
FORGE_CODEX_BIN=codex
# FORGE_DATA_DIR=/absolute/path/to/ForgeData
# FORGE_PROJECTS_DIR=/absolute/path/to/ForgeProjects
# FORGE_PORT=4310
# FORGE_MODEL=your-available-model
# Optional explicit Node binary used by project processes.
# FORGE_NODE_BIN=/absolute/path/to/node
# Gemini uses existing Gemini CLI Google login (or its configured GEMINI_API_KEY).
# FORGE_GEMINI_BIN=/usr/local/bin/gemini
# Ollama is restricted to the local loopback interface. Forge starts it on demand
# when Local AI is selected, and unloads models it used when you switch away.
# FORGE_OLLAMA_BIN=/usr/local/bin/ollama
# FORGE_OLLAMA_URL=http://127.0.0.1:11434
# Forge starts ~/Bonsai-demo/scripts/start_llama_server.sh when Bonsai is selected.
# Set this if your Bonsai-demo directory is elsewhere:
# FORGE_BONSAI_DIR=/Users/you/Bonsai-demo
# FORGE_BONSAI_URL=http://127.0.0.1:8080/v1

# Deploy Center. Token bersifat opsional bila CLI provider sudah login pada akun
# lokal. Jangan menaruh file .env ke Git atau mengirimkannya ke chat AI.
# CLOUDFLARE_API_TOKEN=your-token
# CLOUDFLARE_ACCOUNT_ID=your-account-id
# VERCEL_TOKEN=your-token
# EXPO_TOKEN=your-token
# Database dipasang ke source oleh Agent; gunakan public/anon key pada frontend.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-public-anon-key
# FIREBASE_TOKEN=your-token
